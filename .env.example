# --- Peilung: Konfiguration (Datei nach .env kopieren) ---

# Demo-Modus: alle sechs Kanäle werden simuliert (zum Ausprobieren ohne Schlüssel).
# Berichte aus dem Demo-Modus sind als "Demodaten" gekennzeichnet.
DEMO_MODE=0

# KI-Modelle (alle mit Websuche, so wie Nutzer sie erleben)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenRouter: weitere Modelle über eine Schnittstelle (Schlüssel: openrouter.ai → Settings → Keys).
# Jedes Modell in OPENROUTER_MODELS (durch Komma getrennt) ist ein eigener Kanal im Bericht.
# Auswählen, entfernen und Kosten schätzen am einfachsten mit: python openrouter_config.py
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# Websuche der Modelle: auto (eingebaute Suche des Herstellers, sonst Exa), native, exa, parallel, perplexity
OPENROUTER_SEARCH_ENGINE=auto
# Modell für die Auswertung über OpenRouter (leer = erstes Modell aus OPENROUTER_MODELS)
OPENROUTER_ANALYSIS_MODEL=

# Claude über Ihr Claude-Abo (Pro/Max) statt API-Schlüssel: nutzt die installierte Kommandozeile von
# Claude Code (vorher einmal `claude` starten und anmelden). on = eigener Kanal "Claude (Abo)".
CLAUDE_CODE_MODE=off
# Modell, z. B. opus oder sonnet; leer = Standard Ihres Kontos
CLAUDE_CODE_MODEL=
CLAUDE_CODE_PATH=claude

# Microsoft Copilot hat keine öffentliche API. "browser" steuert copilot.microsoft.com
# über Playwright fern (experimentell, Nutzungsbedingungen von Microsoft beachten).
COPILOT_MODE=off

# Google KI-Übersicht: stellt die Fragen in Ihrem Chrome und liest die "Übersicht mit KI" aus.
# extension = über die Peilung-Erweiterung in Ihrem normalen Chrome (empfohlen, siehe README)
# on        = über ein Chrome mit Fernsteuerung und eigenem Profil (GOOGLE_CDP_URL)
GOOGLE_AI_MODE=off
GOOGLE_CDP_URL=http://127.0.0.1:9222

# Websuche: "brave" (Schlüssel nötig, empfohlen), "duckduckgo" (ohne Schlüssel) oder "off" (ausgeschaltet)
SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=
SEARCH_COUNTRY=de

# Modell für die Auswertung (Fragen ableiten, Anbieter erkennen, Empfehlungen):
# auto = erster vorhandener Schlüssel in der Reihenfolge anthropic, openai, gemini, perplexity, openrouter, claudecode
ANALYSIS_PROVIDER=auto

# Betrieb
PORT=8000
APP_PASSWORD=
DB_PATH=data/peilung.db
MAX_PAGES=150
