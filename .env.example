# --- Peilung: Konfiguration (Datei nach .env kopieren) ---

# Demo-Modus: alle sechs Kanäle werden simuliert (zum Ausprobieren ohne Schlüssel).
# Berichte aus dem Demo-Modus sind als "Demodaten" gekennzeichnet.
DEMO_MODE=0

# KI-Modelle (alle mit Websuche, so wie Nutzer sie erleben)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenRouter: weitere Modelle über eine Schnittstelle (Schlüssel: openrouter.ai → Settings → Keys).
# Jedes Modell in OPENROUTER_MODELS (durch Komma getrennt) ist ein eigener Kanal im Bericht.
# Auswählen, entfernen und Kosten schätzen am einfachsten mit: python openrouter_config.py
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# Websuche der Modelle: auto (eingebaute Suche des Herstellers, sonst Exa), native, exa, parallel, perplexity
OPENROUTER_SEARCH_ENGINE=auto
# Modell für die Auswertung über OpenRouter (leer = erstes Modell aus OPENROUTER_MODELS)
OPENROUTER_ANALYSIS_MODEL=

# Microsoft Copilot hat keine öffentliche API. "browser" steuert copilot.microsoft.com
# über Playwright fern (experimentell, Nutzungsbedingungen von Microsoft beachten).
COPILOT_MODE=off

# Websuche: "brave" (Schlüssel nötig, empfohlen) oder "duckduckgo" (ohne Schlüssel)
SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=
SEARCH_COUNTRY=de

# Modell für die Auswertung (Fragen ableiten, Anbieter erkennen, Empfehlungen):
# auto = erster vorhandener Schlüssel in der Reihenfolge anthropic, openai, gemini, perplexity, openrouter
ANALYSIS_PROVIDER=auto

# Betrieb
PORT=8000
APP_PASSWORD=
DB_PATH=data/peilung.db
MAX_PAGES=150
